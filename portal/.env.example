# Copie para .env.local e preencha com os dados do app Web do projeto Firebase
# (Console do Firebase → Configurações do projeto → Seus apps → SDK). Sem estes valores
# o portal roda em modo demonstração (dados só no navegador, PDFs baixados em ZIP).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Endereço público do portal, usado no QR code dos certificados (ex.: https://eventos-hub.web.app/)
VITE_PUBLIC_URL=
